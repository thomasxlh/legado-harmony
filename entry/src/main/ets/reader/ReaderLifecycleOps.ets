export async function reloadReaderSettingsAfterPageShow(page: ReadBookPage): Promise<void> {
    const reloadSerial = ++page.readerSettingsReloadSerial;
    const paginationSource = page.pagedContentText;
    const previousPaginationKey = paginationSource ?
      page.buildReaderPaginationCacheKey(page.currentChapterIndex, paginationSource) : '';
    const settings = await ReaderSettingsStore.reload(page.hostContext());
    if (reloadSerial !== page.readerSettingsReloadSerial) {
      return;
    }
    ReaderSettingsStore.applyToStorage(settings);
    page.applyLoadedReaderSettings(settings);
    page.cachedRegexRulesKey = '';
    page.cachedRegexRules = [];
    page.refreshReaderTextRender();
    const nextPaginationKey = paginationSource ?
      page.buildReaderPaginationCacheKey(page.currentChapterIndex, paginationSource) : '';
    const missingV2Pagination = !!paginationSource && page.shouldUseReaderLayoutV2(paginationSource) &&
      !page.readerV2PageSet(page.currentChapterIndex, paginationSource);
    if (previousPaginationKey && previousPaginationKey === nextPaginationKey && !missingV2Pagination) {
      return;
    }
    page.pendingRestorePageIndex = Math.max(page.pendingRestorePageIndex, page.currentPageIndex);
    page.readerPaginationCache.clear();
    page.paginateContent(page.content);
}

export async function reloadSourceInteractionsAfterPageShow(page: ReadBookPage): Promise<void> {
    if (!page.book || page.book.origin === 'local' || page.chapters.length === 0) return;
    const engine = ReadBookEngine.get();
    const changed = await engine.refreshSourceInteractionState();
    if (!changed) return;
    page.book = engine.book || page.book;
    page.chapters = [...engine.chapters];
    page.pendingRestorePageIndex = page.currentPageIndex;
    page.readerPaginationCache.clear();
    page.readerPreparedContentCache.clear();
    page.readerPaginationWorkSerial++;
    page.adjacentPaginationPreloadSerial++;
    page.previousPaginationPreloadSerial++;
    await page.loadContent(true, page.currentChapterIndex, true);
}

export function reregisterReaderFontAfterShow(page: ReadBookPage, delayMs: number): void {
    setTimeout(() => {
      if (!page.readerFontFilePath) {
        page.readerSystemFontFamily = ReaderSystemFontHelper.applyToStorage(page.getUIContext());
      }
      page.registerReaderFont();
    }, delayMs);
}
